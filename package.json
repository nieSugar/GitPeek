{
  "name": "gitpeek",
  "displayName": "GitPeek",
  "description": "面向代码上下文的轻量级 VS Code Git 扩展。",
  "version": "0.4.0",
  "publisher": "gitpeek",
  "repository": {
    "type": "git",
    "url": "https://github.com/nieSugar/GitPeek.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/gitpeek.png",
  "scripts": {
    "compile": "node esbuild.js",
    "build": "npm run compile",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "test": "node --test tests/git-service.integration.cjs tests/blame.test.cjs tests/virtualEditor.test.cjs tests/fileHistory.test.mjs tests/commitGraph.integration.cjs tests/commitGraphView.test.cjs tests/checkoutCommit.integration.cjs tests/cherryPickCommit.integration.cjs tests/stashList.integration.cjs tests/stashSave.integration.cjs tests/stashApply.integration.cjs tests/stashDrop.integration.cjs tests/commit-detail.integration.cjs tests/branchCompare.integration.cjs tests/selectionOrigins.integration.cjs tests/reviewChanges.integration.cjs tests/smartCommit.test.mjs tests/contextMenus.test.cjs",
    "package": "npm run check && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitpeek.fileHistory",
        "title": "GitPeek: 文件历史"
      },
      {
        "command": "gitpeek.showCommitGraph",
        "title": "GitPeek: 提交图",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitpeek.stash",
        "title": "GitPeek: Stash 管理"
      },
      {
        "command": "gitpeek.blameCurrentLine",
        "title": "GitPeek: 查看当前行归属"
      },
      {
        "command": "gitpeek.selectionOrigins",
        "title": "GitPeek: 查看选中代码来源"
      },
      {
        "command": "gitpeek.compareWithBase",
        "title": "GitPeek: 与基准分支比较"
      },
      {
        "command": "gitpeek.showBranchChanges",
        "title": "GitPeek: 查看分支变更"
      },
      {
        "command": "gitpeek.reviewChanges",
        "title": "GitPeek: 审查更改"
      },
      {
        "command": "gitpeek.generateCommitMessage",
        "title": "GitPeek: 生成提交信息"
      },
      {
        "command": "gitpeek.refresh",
        "title": "GitPeek: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "gitpeek.internal.tree.openDiff",
        "title": "打开差异",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.tree.showCommit",
        "title": "查看提交详情",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.tree.copyHash",
        "title": "复制完整 Hash",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.reviewChanges.openFromContext",
        "title": "打开差异",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.commit",
        "title": "查看提交详情",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.copy",
        "title": "复制完整 Hash",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.checkout",
        "title": "检出此提交…",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.cherryPick",
        "title": "Cherry-pick 到当前分支…",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.file.open",
        "title": "打开工作区文件",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.file.copyRelativePath",
        "title": "复制相对路径",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitpeek",
          "title": "GitPeek",
          "icon": "resources/gitpeek.svg"
        }
      ]
    },
    "views": {
      "gitpeek": [
        {
          "id": "gitpeek.repository",
          "name": "仓库"
        },
        {
          "id": "gitpeek.changes",
          "name": "更改"
        },
        {
          "id": "gitpeek.branchChanges",
          "name": "分支变更"
        },
        {
          "id": "gitpeek.fileHistory",
          "name": "文件历史"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitpeek.showCommitGraph",
          "when": "view == gitpeek.repository",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.refresh",
          "when": "config.gitpeek.enabled && view =~ /^gitpeek\\.(repository|changes|branchChanges|fileHistory)$/",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "gitpeek.fileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitpeek.fileHistory",
          "when": "config.gitpeek.enabled && resourceScheme == file",
          "group": "gitpeek@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "config.gitpeek.enabled && resourceScheme == file",
          "group": "gitpeek@2"
        },
        {
          "command": "gitpeek.selectionOrigins",
          "when": "config.gitpeek.enabled && editorHasSelection && resourceScheme == file",
          "group": "gitpeek@3"
        }
      ],
      "commandPalette": [
        {
          "command": "gitpeek.internal.tree.openDiff",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.tree.showCommit",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.tree.copyHash",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.openFromContext",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.commit",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.copy",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.checkout",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.cherryPick",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.file.open",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.file.copyRelativePath",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "gitpeek.internal.tree.openDiff",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile))",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.tree.showCommit",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit))",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.tree.copyHash",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit))",
          "group": "2_copy@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.openFromContext",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.file.open",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem =~ /^gitpeek\\.history(Commit|File)$/) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile) || (view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/))",
          "group": "navigation@3"
        },
        {
          "command": "gitpeek.internal.file.copyRelativePath",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem =~ /^gitpeek\\.history(Commit|File)$/) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile) || (view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/))",
          "group": "2_copy@2"
        }
      ],
      "webview/context": [
        {
          "command": "gitpeek.internal.graph.commit",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.graph.copy",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.graph.checkout",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "2_modify@3"
        },
        {
          "command": "gitpeek.internal.graph.cherryPick",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "2_modify@4"
        }
      ],
      "explorer/context": [
        {
          "command": "gitpeek.fileHistory",
          "when": "config.gitpeek.enabled && resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitpeek@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "config.gitpeek.enabled && resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitpeek@2"
        }
      ]
    },
    "configuration": {
      "title": "GitPeek",
      "properties": {
        "gitpeek.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 GitPeek。"
        },
        "gitpeek.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用当前行归属显示。"
        },
        "gitpeek.blame.delay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "解析当前行归属前的延迟，单位为毫秒。"
        },
        "gitpeek.history.limit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "初次加载的文件历史条数。"
        },
        "gitpeek.baseBranch": {
          "type": "string",
          "default": "auto",
          "description": "用于比较的基准分支；auto 表示自动检测。"
        },
        "gitpeek.commit.conventional": {
          "type": "boolean",
          "default": true,
          "description": "建议的提交信息是否使用 Conventional Commits 格式。"
        },
        "gitpeek.commit.defaultType": {
          "type": "string",
          "default": "chore",
          "enum": [
            "feat",
            "fix",
            "refactor",
            "perf",
            "docs",
            "test",
            "style",
            "chore"
          ],
          "description": "默认的 Conventional Commit 类型。"
        }
      }
    }
  },
  "files": [
    "dist/**",
    "resources/**",
    "README.md",
    "package.json"
  ]
}
