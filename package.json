{
  "name": "gitpeek",
  "displayName": "GitPeek",
  "description": "面向代码上下文的轻量级 VS Code Git 扩展。",
  "version": "0.7.1",
  "publisher": "gitpeek",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nieSugar/GitPeek.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "icon": "resources/gitpeek.png",
  "scripts": {
    "compile": "node esbuild.js",
    "build": "npm run compile",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit",
    "benchmark": "node scripts/benchmark.cjs",
    "test": "node --test tests/git-service.integration.cjs tests/blame.test.cjs tests/virtualEditor.test.cjs tests/fileHistory.test.mjs tests/commitGraph.integration.cjs tests/commitGraphView.test.cjs tests/checkoutCommit.integration.cjs tests/cherryPickCommit.integration.cjs tests/stashList.integration.cjs tests/stashSave.integration.cjs tests/stashApply.integration.cjs tests/stashDrop.integration.cjs tests/commit-detail.integration.cjs tests/branchCompare.integration.cjs tests/selectionOrigins.integration.cjs tests/reviewChanges.integration.cjs tests/smartCommit.test.mjs tests/contextMenus.test.cjs tests/workflows.integration.cjs tests/detailsCompare.regressions.cjs tests/historyStage.regressions.cjs tests/search-regressions.test.cjs tests/batchStage.integration.cjs tests/batchStageView.test.cjs tests/fileBlame.test.cjs tests/revisionNavigation.test.cjs tests/selectionSnapshot.integration.cjs tests/interactiveRebase.integration.cjs tests/rebaseEditor.test.cjs tests/comparisonLayout.test.cjs tests/historyReferences.integration.cjs tests/historyInvestigation.integration.cjs tests/historyLifecycle.test.cjs",
    "package": "npm run check && npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "gitpeek.fileHistory",
        "title": "GitPeek: 文件历史"
      },
      {
        "command": "gitpeek.showCommitGraph",
        "title": "GitPeek: 提交图",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitpeek.interactiveRebase",
        "title": "GitPeek: 整理提交（交互式 Rebase）",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.continueRebase",
        "title": "GitPeek: 继续 Rebase",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.abortRebase",
        "title": "GitPeek: 中止 Rebase",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.stash",
        "title": "GitPeek: Stash 管理"
      },
      {
        "command": "gitpeek.blameCurrentLine",
        "title": "GitPeek: 查看当前行归属"
      },
      {
        "command": "gitpeek.selectionOrigins",
        "title": "GitPeek: 查看选中代码来源"
      },
      {
        "command": "gitpeek.compareWithBase",
        "title": "GitPeek: 与基准分支比较"
      },
      {
        "command": "gitpeek.showBranchChanges",
        "title": "GitPeek: 查看分支变更"
      },
      {
        "command": "gitpeek.reviewChanges",
        "title": "GitPeek: 审查更改"
      },
      {
        "command": "gitpeek.generateCommitMessage",
        "title": "GitPeek: 生成提交信息"
      },
      {
        "command": "gitpeek.refresh",
        "title": "GitPeek: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "gitpeek.internal.tree.openDiff",
        "title": "打开差异",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.tree.showCommit",
        "title": "查看提交详情",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.tree.copyHash",
        "title": "复制完整 Hash",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.reviewChanges.openFromContext",
        "title": "打开差异",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.commit",
        "title": "查看提交详情",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.copy",
        "title": "复制完整 Hash",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.checkout",
        "title": "检出此提交…",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.rebase",
        "title": "从此提交开始整理…",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.cherryPick",
        "title": "Cherry-pick 到当前分支…",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.file.open",
        "title": "打开工作区文件",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.file.copyRelativePath",
        "title": "复制相对路径",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.selectionHistory",
        "title": "选区演进历史",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.details.pin",
        "title": "固定提交详情",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(pin)"
      },
      {
        "command": "gitpeek.internal.details.unpin",
        "title": "取消固定",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(pinned)"
      },
      {
        "command": "gitpeek.internal.compare.selectCompare",
        "title": "选择此提交进行比较",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.compare.compareSelected",
        "title": "与所选提交比较",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.compare.clear",
        "title": "清除比较选择",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(clear-all)"
      },
      {
        "command": "gitpeek.internal.compare.working",
        "title": "与工作区文件比较",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.reviewChanges.stage",
        "title": "暂存文件",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(add)"
      },
      {
        "command": "gitpeek.internal.reviewChanges.unstage",
        "title": "取消暂存",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(remove)"
      },
      {
        "command": "gitpeek.internal.graph.selectCompare",
        "title": "选择此提交进行比较",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.graph.compareSelected",
        "title": "与所选提交比较",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.reviewChanges.stageGroup",
        "title": "暂存此分组",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(add)"
      },
      {
        "command": "gitpeek.internal.reviewChanges.unstageGroup",
        "title": "取消暂存此分组",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled",
        "icon": "$(remove)"
      },
      {
        "command": "gitpeek.toggleFileBlame",
        "title": "GitPeek: 切换整文件归属",
        "icon": "$(account)",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.previousFileRevision",
        "title": "GitPeek: 上一处文件修改",
        "icon": "$(arrow-left)",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.nextFileRevision",
        "title": "GitPeek: 下一处文件修改",
        "icon": "$(arrow-right)",
        "enablement": "config.gitpeek.enabled"
      },
      {
        "command": "gitpeek.internal.fileHistory.pin",
        "title": "固定文件历史",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyHasTarget",
        "icon": "$(pin)"
      },
      {
        "command": "gitpeek.internal.fileHistory.unpin",
        "title": "跟随当前编辑器",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyPinned",
        "icon": "$(pinned)"
      },
      {
        "command": "gitpeek.internal.fileHistory.chooseRef",
        "title": "选择历史分支或引用",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyHasTarget",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitpeek.internal.fileHistory.chooseFile",
        "title": "在当前版本中选择文件",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyHasTarget",
        "icon": "$(go-to-file)"
      },
      {
        "command": "gitpeek.internal.fileHistory.back",
        "title": "返回上一个调查对象",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyCanGoBack",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitpeek.internal.fileHistory.forward",
        "title": "前往下一个调查对象",
        "category": "GitPeek",
        "enablement": "config.gitpeek.enabled && gitpeek.historyCanGoForward",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitpeek",
          "title": "GitPeek",
          "icon": "resources/gitpeek.svg"
        }
      ]
    },
    "views": {
      "gitpeek": [
        {
          "id": "gitpeek.repository",
          "name": "仓库"
        },
        {
          "id": "gitpeek.fileHistory",
          "name": "文件历史"
        },
        {
          "id": "gitpeek.commitDetails",
          "name": "提交详情",
          "when": "config.gitpeek.enabled && gitpeek.hasCommitDetails"
        },
        {
          "id": "gitpeek.comparison",
          "name": "提交比较",
          "when": "config.gitpeek.enabled && gitpeek.hasComparison"
        },
        {
          "id": "gitpeek.branchChanges",
          "name": "分支变更",
          "visibility": "collapsed"
        },
        {
          "id": "gitpeek.changes",
          "name": "更改",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "gitpeek.showCommitGraph",
          "when": "view == gitpeek.repository",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.refresh",
          "when": "config.gitpeek.enabled && view =~ /^gitpeek\\.(repository|changes|branchChanges|fileHistory)$/",
          "group": "navigation@9"
        },
        {
          "command": "gitpeek.internal.details.pin",
          "when": "view == gitpeek.commitDetails && !gitpeek.detailsPinned",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.details.unpin",
          "when": "view == gitpeek.commitDetails && gitpeek.detailsPinned",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.compare.clear",
          "when": "view == gitpeek.comparison",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.fileHistory.pin",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory && !gitpeek.historyPinned",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.fileHistory.unpin",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory && gitpeek.historyPinned",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.fileHistory.chooseRef",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.fileHistory.chooseFile",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory",
          "group": "1_investigation@1"
        },
        {
          "command": "gitpeek.internal.fileHistory.back",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory && gitpeek.historyCanGoBack",
          "group": "navigation@3"
        },
        {
          "command": "gitpeek.internal.fileHistory.forward",
          "when": "config.gitpeek.enabled && view == gitpeek.fileHistory && gitpeek.historyCanGoForward",
          "group": "navigation@4"
        }
      ],
      "editor/title": [
        {
          "command": "gitpeek.fileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "resourceScheme == file",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.previousFileRevision",
          "when": "config.gitpeek.enabled && resourceScheme == gitpeek-commit",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.nextFileRevision",
          "when": "config.gitpeek.enabled && resourceScheme == gitpeek-commit",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "gitpeek.fileHistory",
          "when": "config.gitpeek.enabled && resourceScheme == file",
          "group": "gitpeek@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "config.gitpeek.enabled && resourceScheme == file",
          "group": "gitpeek@2"
        },
        {
          "command": "gitpeek.selectionOrigins",
          "when": "config.gitpeek.enabled && editorHasSelection && resourceScheme == file",
          "group": "gitpeek@3"
        },
        {
          "command": "gitpeek.selectionHistory",
          "when": "config.gitpeek.enabled && editorHasSelection && resourceScheme == file",
          "group": "gitpeek@4"
        },
        {
          "command": "gitpeek.toggleFileBlame",
          "when": "config.gitpeek.enabled && resourceScheme == file",
          "group": "gitpeek@5"
        }
      ],
      "commandPalette": [
        {
          "command": "gitpeek.interactiveRebase",
          "when": "config.gitpeek.enabled"
        },
        {
          "command": "gitpeek.continueRebase",
          "when": "config.gitpeek.enabled"
        },
        {
          "command": "gitpeek.abortRebase",
          "when": "config.gitpeek.enabled"
        },
        {
          "command": "gitpeek.internal.graph.rebase",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.tree.openDiff",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.tree.showCommit",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.tree.copyHash",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.openFromContext",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.commit",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.copy",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.checkout",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.cherryPick",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.file.open",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.file.copyRelativePath",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.details.pin",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.details.unpin",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.compare.selectCompare",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.compare.compareSelected",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.compare.clear",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.compare.working",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stage",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstage",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.selectCompare",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.graph.compareSelected",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stageGroup",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstageGroup",
          "when": "false"
        },
        {
          "command": "gitpeek.previousFileRevision",
          "when": "config.gitpeek.enabled && resourceScheme == gitpeek-commit"
        },
        {
          "command": "gitpeek.nextFileRevision",
          "when": "config.gitpeek.enabled && resourceScheme == gitpeek-commit"
        },
        {
          "command": "gitpeek.internal.fileHistory.pin",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.fileHistory.unpin",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.fileHistory.chooseRef",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.fileHistory.chooseFile",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.fileHistory.back",
          "when": "false"
        },
        {
          "command": "gitpeek.internal.fileHistory.forward",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "gitpeek.internal.tree.openDiff",
          "when": "(config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile))) || (config.gitpeek.enabled && ((view == gitpeek.commitDetails && viewItem == gitpeek.detailFile) || (view == gitpeek.comparison && viewItem == gitpeek.comparisonFile)))",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.tree.showCommit",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit))",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.tree.copyHash",
          "when": "(config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit))) || (config.gitpeek.enabled && view == gitpeek.commitDetails && viewItem =~ /^gitpeek\\.detail(Commit|File)$/)",
          "group": "2_copy@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.openFromContext",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.file.open",
          "when": "(config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem =~ /^gitpeek\\.history(Commit|File)$/) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile) || (view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/))) || (config.gitpeek.enabled && ((view == gitpeek.commitDetails && viewItem == gitpeek.detailFile) || (view == gitpeek.comparison && viewItem == gitpeek.comparisonFile)))",
          "group": "navigation@3"
        },
        {
          "command": "gitpeek.internal.file.copyRelativePath",
          "when": "(config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem =~ /^gitpeek\\.history(Commit|File)$/) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchFile) || (view == gitpeek.changes && viewItem =~ /^gitpeek\\.review\\.(staged|unstaged|untracked)$/))) || (config.gitpeek.enabled && ((view == gitpeek.commitDetails && viewItem == gitpeek.detailFile) || (view == gitpeek.comparison && viewItem == gitpeek.comparisonFile)))",
          "group": "2_copy@2"
        },
        {
          "command": "gitpeek.internal.compare.selectCompare",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit) || (view == gitpeek.commitDetails && viewItem =~ /^gitpeek\\.detail(Commit|File)$/))",
          "group": "3_compare@1"
        },
        {
          "command": "gitpeek.internal.compare.compareSelected",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.branchChanges && viewItem == gitpeek.branchCommit) || (view == gitpeek.commitDetails && viewItem =~ /^gitpeek\\.detail(Commit|File)$/))",
          "group": "3_compare@2"
        },
        {
          "command": "gitpeek.internal.compare.working",
          "when": "config.gitpeek.enabled && ((view == gitpeek.fileHistory && viewItem == gitpeek.historyCommit) || (view == gitpeek.commitDetails && viewItem == gitpeek.detailFile))",
          "group": "3_compare@3"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stage",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && (viewItem == gitpeek.review.unstaged || viewItem == gitpeek.review.untracked)",
          "group": "1_modify@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstage",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem == gitpeek.review.staged",
          "group": "1_modify@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stageGroup",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && (viewItem == gitpeek.reviewGroup.unstaged || viewItem == gitpeek.reviewGroup.untracked)",
          "group": "1_modify@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stageGroup",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && (viewItem == gitpeek.reviewGroup.unstaged || viewItem == gitpeek.reviewGroup.untracked)",
          "group": "inline@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstageGroup",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem == gitpeek.reviewGroup.staged",
          "group": "1_modify@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstageGroup",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem == gitpeek.reviewGroup.staged",
          "group": "inline@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.stage",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && (viewItem == gitpeek.review.unstaged || viewItem == gitpeek.review.untracked)",
          "group": "inline@1"
        },
        {
          "command": "gitpeek.internal.reviewChanges.unstage",
          "when": "config.gitpeek.enabled && view == gitpeek.changes && viewItem == gitpeek.review.staged",
          "group": "inline@1"
        }
      ],
      "webview/context": [
        {
          "command": "gitpeek.internal.graph.commit",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "navigation@1"
        },
        {
          "command": "gitpeek.internal.graph.copy",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "navigation@2"
        },
        {
          "command": "gitpeek.internal.graph.checkout",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "2_modify@3"
        },
        {
          "command": "gitpeek.internal.graph.cherryPick",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "2_modify@4"
        },
        {
          "command": "gitpeek.internal.graph.rebase",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "2_modify@5"
        },
        {
          "command": "gitpeek.internal.graph.selectCompare",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "3_compare@1"
        },
        {
          "command": "gitpeek.internal.graph.compareSelected",
          "when": "config.gitpeek.enabled && webviewId == gitpeek.commitGraph && webviewSection == commit",
          "group": "3_compare@2"
        }
      ],
      "explorer/context": [
        {
          "command": "gitpeek.fileHistory",
          "when": "config.gitpeek.enabled && resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitpeek@1"
        },
        {
          "command": "gitpeek.compareWithBase",
          "when": "config.gitpeek.enabled && resourceScheme == file && !explorerResourceIsFolder",
          "group": "gitpeek@2"
        }
      ]
    },
    "configuration": {
      "title": "GitPeek",
      "properties": {
        "gitpeek.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用 GitPeek。"
        },
        "gitpeek.blame.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用当前行归属显示。"
        },
        "gitpeek.blame.delay": {
          "type": "number",
          "default": 100,
          "minimum": 0,
          "description": "首次加载文件归属前的延迟，单位为毫秒；已缓存的行立即显示。"
        },
        "gitpeek.history.limit": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "初次加载的文件历史条数。"
        },
        "gitpeek.baseBranch": {
          "type": "string",
          "default": "auto",
          "description": "用于比较的基准分支；auto 表示自动检测。"
        },
        "gitpeek.commit.conventional": {
          "type": "boolean",
          "default": true,
          "description": "建议的提交信息是否使用 Conventional Commits 格式。"
        },
        "gitpeek.commit.defaultType": {
          "type": "string",
          "default": "chore",
          "enum": [
            "feat",
            "fix",
            "refactor",
            "perf",
            "docs",
            "test",
            "style",
            "chore"
          ],
          "description": "默认的 Conventional Commit 类型。"
        }
      }
    }
  },
  "files": [
    "dist/**",
    "resources/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "package.json"
  ]
}
